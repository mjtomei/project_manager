{
  "selection": "Whole specified document collections; no manual quality curation. Individual public examples retained where no bulk collection was identified.",
  "label": "known_good",
  "label_basis": "User-directed working assumption for comparison against matched LLM drafts.",
  "immediate_scope": "Bootstrap document-only evaluator calibration and automated prompt improvement using the known-good corpus without manual quality curation, then adopt measured improvements in PM's existing planning prompts. See pm/plans/plan-doc-eval.md.",
  "later_scope": "Evaluate execution on existing benchmark tasks against direct prompting without a separate plan, then add full PM orchestration. The logged proposal/code/test pairs are additional tests; extend to FPGA correctness and resource/timing results and OpenROAD results under fixed constraints. See pm/docs/planning-evaluation.md.",
  "sources": [
    {
      "id": "go-proposals",
      "kind": "git",
      "url": "https://github.com/golang/proposal.git",
      "domain": "software",
      "document_kind": "design_proposal",
      "sparse": [
        "/design/",
        "/LICENSE*",
        "/COPYING*",
        "/README.md"
      ],
      "include": [
        "design/*.md"
      ],
      "split_group": "go-proposals",
      "context": {
        "request": "Write a design document for a proposal to the Go project, for the design/ directory of the golang/proposal repository.",
        "collectors": [
          {
            "type": "github",
            "kind": "tracking_issue",
            "label": "proposal tracking issue",
            "repo": "golang/go",
            "path": "issues",
            "numbers": [
              {
                "from": "identity",
                "pattern": "^design/(\\d+)-"
              },
              {
                "from": "header",
                "pattern": "(?:golang\\.org/issues?/|go\\.dev/issues?/|github\\.com/golang/go/issues/)(\\d+)"
              }
            ]
          },
          {
            "type": "header",
            "format": "go",
            "fields": [
              "Author(s)",
              "Authors",
              "Author"
            ],
            "label": "design document byline"
          },
          {
            "type": "process",
            "files": [
              "README.md",
              "design/TEMPLATE.md"
            ],
            "label": "Go proposal process and design template"
          }
        ]
      }
    },
    {
      "id": "rust-rfcs",
      "kind": "git",
      "url": "https://github.com/rust-lang/rfcs.git",
      "domain": "software",
      "document_kind": "design_proposal",
      "sparse": [
        "/text/",
        "/LICENSE*",
        "/COPYING*",
        "/README.md",
        "/0000-template.md"
      ],
      "include": [
        "text/*.md"
      ],
      "split_group": "rust",
      "context": {
        "request": "Write a Rust RFC for the rust-lang/rfcs repository.",
        "collectors": [
          {
            "type": "github",
            "kind": "review_thread",
            "label": "RFC pull request opening post",
            "repo": "rust-lang/rfcs",
            "path": "pull",
            "numbers": [
              {
                "from": "identity",
                "pattern": "^text/(\\d+)-"
              }
            ]
          },
          {
            "type": "github",
            "kind": "tracking_issue",
            "label": "Rust tracking issue",
            "repo": "rust-lang/rust",
            "path": "issues",
            "numbers": [
              {
                "from": "header",
                "pattern": "Rust Issue:[^\\n]*?rust-lang/rust(?:/issues/|#)(\\d+)",
                "chars": 1500
              }
            ]
          },
          {
            "type": "header",
            "format": "dash_list",
            "fields": [
              "Feature Name",
              "Start Date"
            ],
            "label": "RFC header metadata"
          },
          {
            "type": "process",
            "files": [
              "README.md",
              "0000-template.md"
            ],
            "label": "Rust RFC process and template"
          }
        ]
      }
    },
    {
      "id": "rust-goals",
      "kind": "git",
      "url": "https://github.com/rust-lang/goals.git",
      "domain": "software",
      "document_kind": "project_plan",
      "sparse": [
        "/src/",
        "/LICENSE*",
        "/COPYING*"
      ],
      "include": [
        "src/*.md"
      ],
      "split_group": "rust",
      "context": {
        "request": "Write a Rust project goal proposal for the rust-lang/rust-project-goals repository.",
        "collectors": [
          {
            "type": "github",
            "kind": "tracking_issue",
            "label": "project goal tracking issue",
            "repo": "rust-lang/rust-project-goals",
            "path": "issues",
            "numbers": [
              {
                "from": "header",
                "pattern": "Tracking issue[^\\n]*?rust-lang/(?:rust-project-goals|goals)#(\\d+)",
                "chars": 2500
              }
            ],
            "documents": "^src/20\\d\\d"
          },
          {
            "type": "header",
            "format": "md_table",
            "fields": [
              "Point of contact",
              "Contact",
              "Teams",
              "Team(s)",
              "Task owners",
              "Zulip channel"
            ],
            "documents": "^src/20\\d\\d",
            "label": "goal metadata table"
          },
          {
            "type": "markdown_index",
            "files": [
              "README.md",
              "goals.md"
            ],
            "documents": "^src/20\\d\\d",
            "label": "goal slate entry"
          },
          {
            "type": "process",
            "files": [
              "src/TEMPLATE.md",
              "src/how_to/propose_a_goal.md"
            ],
            "label": "Rust project goal template and proposal guide"
          }
        ]
      }
    },
