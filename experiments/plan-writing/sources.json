      "split_group": "python-peps",
      "context": {
        "request": "Write a Python Enhancement Proposal (PEP) for the python/peps repository.",
        "collectors": [
          {
            "type": "header",
            "format": "rfc822",
            "fields": [
              "PEP",
              "Title",
              "Author",
              "Sponsor",
              "Type",
              "Topic",
              "Created",
              "Python-Version",
              "Requires",
              "Replaces",
              "Discussions-To"
            ],
            "label": "PEP preamble (decision fields excluded)"
          },
          {
            "type": "discourse",
            "label": "discussion thread opening post"
          },
          {
            "type": "process",
            "files": [
              "peps/pep-0001.rst",
              "peps/pep-0012.rst"
            ],
            "label": "PEP process (PEP 1) and template (PEP 12)"
          }
        ]
      }
    },
