+# Where each working session records a proposal (see _proposals_block).
+# Sessions running in the PR's own workdir write a PR note there (later
+# prompts merge the workdir's notes, so sign-off sees it even uncommitted);
+# sessions in a throwaway clone write next to their captures, which persist
+# on the host and are read by sign-off; a session with no PR reports them.
+_PROPOSAL_FIELDS = (
+    "Proposal (<feature|refactor|recipe|regression|plan|investigation>): "
+    "<the idea>. Observed: <what you saw, citing a file, commit, capture or "
+    "scenario>. Origin: {origin}. Status: proposed.")
