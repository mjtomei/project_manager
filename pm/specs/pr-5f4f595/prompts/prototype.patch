+def _wrap_paragraphs(text: str, width: int = 76) -> str:
+    """Re-flow prose paragraphs; indented (command/example) lines stay."""
+    import textwrap
+    out = []
+    for para in text.split("\n\n"):
+        if para.startswith((" ", "#")) or "\n " in para:
+            out.append(para)
+        else:
+            # Keep `inline code` on one line: protect its spaces.
+            parts = " ".join(para.split()).split("`")
+            for i in range(1, len(parts), 2):
+                parts[i] = parts[i].replace(" ", "\x00")
+            filled = textwrap.fill("`".join(parts), width=width,
+                                   break_on_hyphens=False,
+                                   break_long_words=False)
+            out.append(filled.replace("\x00", " "))
+    return "\n\n".join(out)
+
+
+def _proposals_block(pr_id: str | None, *, origin: str,
+                     record_in: str = "note", proposals_path: str = "",
+                     incidental_bugs: bool = True,
+                     fix_rule: str = "") -> str:
+    """Shared guidance: any working session may record evidence-backed
+    proposals for work outside its PR's scope.
+
+    *origin* names the session in the recorded line (e.g. ``"pr-x QA
+    scenario 3"``).  *record_in* is ``"note"`` (a PR note in this
+    checkout), ``"captures"`` (a ``proposals.md`` beside the session's
+    captures at *proposals_path* — a throwaway clone's notes would be lost)
+    or ``"report"`` (no PR: report them in the run's findings).  *fix_rule*
+    names the role's own consequence for an in-scope fix.
+    """
+    fields = _PROPOSAL_FIELDS.format(origin=origin)
+    if record_in == "report":
+        in_scope = ("Problems this run's instruction asks you to check are "
+                    "findings, not proposals: they follow the verdict and "
+                    "Incidental Bugs rules above.")
+    else:
+        in_scope = ("Anything you would change in *this* PR is not a "
+                    "proposal: bugs, fixes, suggestions and test gaps follow "
+                    "this prompt's own rules"
+                    + (f" ({fix_rule})" if fix_rule else "")
+                    + ". Do not move them here to finish sooner.")
+    search = ("Say what you observed and what you only suspect. Search "
+              "existing work first (`pm pr list`, `pm pr list --plan "
+              "<plan>`, `pm pr show <id>`).")
+    if record_in == "captures":
+        record = (
+            f"Record each one as a bullet in `{proposals_path}` (create it "
+            "if needed). That file is kept with your captures, outside the "
+            "PR branch; the PR's sign-off reads it and decides what to file, "
+            "so do not file PRs or add notes for a proposal from here, and "
+            "do not commit or push just to record one:\n\n"
+            f"  - {fields}\n\n"
+            + search + " If a PR already covers it, write `Status: matches "
+            "<that-pr>`.")
+    elif record_in == "report":
+        record = (
+            "There is no PR for this run, so include each one in your "
+            "findings, in this shape:\n\n"
+            f"  - {fields}\n\n"
+            + search + " If a PR already covers it, add your observation "
+            "there (`pm pr note add <that-pr> '...'`) and write `Status: "
+            "linked to <that-pr>`. File a new pending PR (`pm pr add`) only "
+            "when the work clearly stands on its own and nothing matches; "
+            "name this run and the evidence in its description.")
+    else:
+        record = (
+            "Record each one as a note on this PR — the PR's sign-off "
+            "reviews every proposal and bug recorded during the PR:\n\n"
+            f"  pm pr note add {pr_id} '{fields}'\n\n"
+            + search + " If a PR or note already covers it, add your "
+            "observation to that PR (`pm pr note add <that-pr> '...'`) and "
+            "write `Status: linked to <that-pr>` in your note here. File a "
+            "new pending PR (`pm pr add`) only when the work clearly stands "
+            "on its own and nothing matches; name its origin and the "
+            "evidence in its description, and write `Status: filed as "
+            "<new-pr>`.")
+    if incidental_bugs and record_in == "captures":
+        bug_line = ("Record a bug you file or fix under Incidental Bugs in "
+                    "the same file, starting with `Bug` instead of "
+                    "`Proposal` and naming the PR you filed or your fix "
+                    "commit.")
+    elif incidental_bugs:
+        bug_line = ("Record a bug you file or fix under Incidental Bugs the "
+                    "same way, starting with `Bug` instead of `Proposal`.")
+    else:
+        bug_line = ("Record a bug you notice outside this PR's scope the "
+                    "same way, starting with `Bug` instead of `Proposal` "
+                    "(`Status: fixed in <commit>` if you fixed it).")
+    body = "\n\n".join([
+        "If your own work here shows that something outside "
+        + ("this PR's scope" if record_in != "report" else "this run's check")
+        + " is worth doing — a feature, a refactoring or architecture "
+        "change, a new or changed QA recipe or regression, a plan change, or "
+        "an investigation — record it. You are not asked to search for "
+        "proposals or to judge anything beyond the work in front of you; "
+        "recording nothing is the normal outcome when nothing you observed "
+        "supports a proposal.",
+        in_scope,
+        record,
+        bug_line,
+        "Recording or filing work does not start it and gives you no "
+        "authority to change other PRs, plans or QA recipes.",
+    ])
+    return "\n## Proposals and Follow-up Ideas\n\n" + _wrap_paragraphs(body) + "\n"
+
+
