+def _signoff_identity(pr: dict, pr_id: str) -> tuple[str, str]:
+    """(prompt identity line, report header requirement) for sign-off.
+
+    Uses only the recorded GitHub number/URL; a project without a GitHub PR
+    is identified by its pm id alone, and no link is invented.
+    """
+    num = pr.get("gh_pr_number")
+    num = num if isinstance(num, int) and not isinstance(num, bool) \
+        and num > 0 else None
+    url = pr.get("gh_pr")
+    url = url if isinstance(url, str) \
+        and url.startswith(("https://", "http://")) else None
+    if num and url:
+        return (f"GitHub PR [#{num}]({url}) · pm PR id `{pr_id}`",
+                f"the GitHub PR number as a clickable link — "
+                f"`<a href=\"{url}\">#{num}</a>` — and the pm PR id "
+                f"`{pr_id}`, both prominent above the summary")
+    if num:
+        return (f"GitHub PR #{num} (no URL recorded) · pm PR id `{pr_id}`",
+                f"the GitHub PR number #{num} (no URL is recorded, so do not "
+                f"link it) and the pm PR id `{pr_id}`")
+    return (f"pm PR id `{pr_id}` (no GitHub PR is recorded)",
+            f"the pm PR id `{pr_id}`; no GitHub PR is recorded for it, so do "
+            "not invent a GitHub number or link")
+
+
+def _planning_paths(data: dict) -> list[str]:
+    """``pm/project.yaml`` plus where the registered plan files live."""
+    out = {"pm/project.yaml"}
+    for plan in data.get("plans") or []:
+        f = plan.get("file") if isinstance(plan, dict) else None
+        if not isinstance(f, str) or not f:
+            continue
+        head, _, _ = f.partition("/")
+        out.add(f"pm/{head}" if "/" in f else f"pm/{f}")
+    return sorted(out, key=lambda x: (x != "pm/project.yaml", x))
+
+
